<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <Spinner
        android:id="@+id/spinnerAtividade"
        android:layout_width="409dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toTopOf="@+id/edtData"
        tools:layout_editor_absoluteX="1dp" />

    <EditText
        android:id="@+id/edtTreino"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="75dp"
        android:layout_marginBottom="15dp"
        android:ems="10"
        android:inputType="text"
        android:text="Treino"
        app:layout_constraintBottom_toTopOf="@+id/spinnerAtividade"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="100dp" />

    <EditText
        android:id="@+id/edtData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ems="10"
        android:inputType="text"
        android:text="Data"
        app:layout_constraintTop_toBottomOf="@+id/spinnerAtividade"
        tools:layout_editor_absoluteX="100dp" />

    <EditText
        android:id="@+id/edtDuracao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        android:ems="10"
        android:inputType="text"
        app:layout_constraintBottom_toTopOf="@+id/spinnerIntensidade"
        tools:layout_editor_absoluteX="99dp" />

    <Spinner
        android:id="@+id/spinnerIntensidade"
        android:layout_width="409dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:layout_constraintBottom_toTopOf="@+id/checkBox"
        tools:layout_editor_absoluteX="1dp" />

    <CheckBox
        android:id="@+id/checkBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="29dp"
        android:text="Treino Concluído?"
        app:layout_constraintBottom_toTopOf="@+id/button"
        tools:layout_editor_absoluteX="131dp" />

    <Button
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:text="Salvar"
        app:layout_constraintBottom_toTopOf="@+id/listaTreino"
        tools:layout_editor_absoluteX="161dp" />

    <ListView
        android:id="@+id/listaTreino"
        android:layout_width="409dp"
        android:layout_height="248dp"
        android:layout_marginBottom="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:layout_editor_absoluteX="1dp" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="312dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:text="Duração do Treino"
        app:layout_constraintTop_toBottomOf="@+id/edtData"
        tools:layout_editor_absoluteX="131dp" />

</androidx.constraintlayout.widget.ConstraintLayout>